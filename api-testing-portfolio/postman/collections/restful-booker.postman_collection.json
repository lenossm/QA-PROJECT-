    {
      "name": "Booking lifecycle (chained)",
      "item": [
        {
          "name": "Create booking with dynamic data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique test data per run so no request depends on",
                  "// pre-existing state of the shared public instance.",
                  "const now = Date.now();",
                  "const checkin = new Date(now + 30 * 24 * 60 * 60 * 1000);",
                  "const checkout = new Date(now + 35 * 24 * 60 * 60 * 1000);",
                  "",
                  "pm.collectionVariables.set('bookingFirstname', 'Elene');",
                  "pm.collectionVariables.set('bookingLastname', `PostmanRun-${now}`);",
                  "pm.collectionVariables.set('bookingPrice', String(100 + Math.floor(Math.random() * 900)));",
                  "pm.collectionVariables.set('bookingCheckin', checkin.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('bookingCheckout', checkout.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response matches the created-booking schema', function () {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: 'object',",
                  "        required: ['bookingid', 'booking'],",
                  "        properties: {",
                  "            bookingid: { type: 'integer', minimum: 1 },",
                  "            booking: {",
                  "                type: 'object',",
                  "                required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "                properties: {",
                  "                    firstname: { type: 'string' },",
                  "                    lastname: { type: 'string' },",
                  "                    totalprice: { type: 'number' },",
                  "                    depositpaid: { type: 'boolean' },",
                  "                    bookingdates: {",
                  "                        type: 'object',",
                  "                        required: ['checkin', 'checkout']",
                  "                    },",
                  "                    additionalneeds: { type: 'string' }",
                  "                }",
                  "            }",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "pm.test('Stored booking equals the sent payload', function () {",
                  "    const booking = pm.response.json().booking;",
                  "    pm.expect(booking.firstname).to.eql(pm.collectionVariables.get('bookingFirstname'));",
                  "    pm.expect(booking.lastname).to.eql(pm.collectionVariables.get('bookingLastname'));",
                  "    pm.expect(booking.totalprice).to.eql(Number(pm.collectionVariables.get('bookingPrice')));",
                  "    pm.expect(booking.depositpaid).to.eql(true);",
                  "    pm.expect(booking.bookingdates.checkin).to.eql(pm.collectionVariables.get('bookingCheckin'));",
                  "    pm.expect(booking.bookingdates.checkout).to.eql(pm.collectionVariables.get('bookingCheckout'));",
                  "});",
                  "",
                  "// Chain: the rest of the folder works with this booking.",
                  "pm.collectionVariables.set('bookingId', String(pm.response.json().bookingid));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{bookingFirstname}}\",\n  \"lastname\": \"{{bookingLastname}}\",\n  \"totalprice\": {{bookingPrice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{bookingCheckin}}\",\n    \"checkout\": \"{{bookingCheckout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/booking", "host": ["{{baseUrl}}"], "path": ["booking"] }
          }
        },
        {
          "name": "Get booking IDs filtered by the unique lastname",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array of bookingid objects', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').with.length.above(0);",
                  "    body.forEach(function (entry) {",
                  "        pm.expect(entry).to.have.property('bookingid').that.is.a('number');",
                  "    });",
                  "});",
                  "",
                  "pm.test('List contains the booking created in the previous request', function () {",
                  "    const ids = pm.response.json().map(function (entry) { return entry.bookingid; });",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking?lastname={{bookingLastname}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking"],
              "query": [{ "key": "lastname", "value": "{{bookingLastname}}" }]
            }
          }
        },
        {
          "name": "Get booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Field values and types match what was created', function () {",
                  "    const booking = pm.response.json();",
                  "    pm.expect(booking.firstname).to.be.a('string').and.to.eql(pm.collectionVariables.get('bookingFirstname'));",
                  "    pm.expect(booking.lastname).to.be.a('string').and.to.eql(pm.collectionVariables.get('bookingLastname'));",
                  "    pm.expect(booking.totalprice).to.be.a('number').and.to.eql(Number(pm.collectionVariables.get('bookingPrice')));",
                  "    pm.expect(booking.depositpaid).to.be.a('boolean');",
                  "    pm.expect(booking.bookingdates.checkin).to.eql(pm.collectionVariables.get('bookingCheckin'));",
                  "    pm.expect(booking.bookingdates.checkout).to.eql(pm.collectionVariables.get('bookingCheckout'));",
                  "});",
                  "",
                  "pm.test('Response time is within the documented 5000 ms budget', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Update booking (PUT, authenticated)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New values for the full update; verified in the test script.",
                  "pm.collectionVariables.set('bookingFirstname', 'Updated');",
                  "pm.collectionVariables.set('bookingPrice', '777');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Updated values are returned', function () {",
                  "    const booking = pm.response.json();",
                  "    pm.expect(booking.firstname).to.eql('Updated');",
                  "    pm.expect(booking.totalprice).to.eql(777);",
                  "    pm.expect(booking.additionalneeds).to.eql('Late checkout');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "token={{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{bookingFirstname}}\",\n  \"lastname\": \"{{bookingLastname}}\",\n  \"totalprice\": {{bookingPrice}},\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{bookingCheckin}}\",\n    \"checkout\": \"{{bookingCheckout}}\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Partial update booking (PATCH, authenticated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Patched field changed and untouched fields survived', function () {",
                  "    const booking = pm.response.json();",
                  "    pm.expect(booking.additionalneeds).to.eql('Airport transfer');",
                  "    pm.expect(booking.firstname).to.eql('Updated');",
                  "    pm.expect(booking.totalprice).to.eql(777);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "token={{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"additionalneeds\": \"Airport transfer\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Delete booking (authenticated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Actual behaviour: 201 Created instead of 200/204 (DEF-API-002).",
                  "pm.test('Status code is 201 (documented API quirk)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Cookie", "value": "token={{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Verify deleted booking returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 — the booking is gone', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["booking", "{{bookingId}}"]
            }
          }
        }
      ]
    },
