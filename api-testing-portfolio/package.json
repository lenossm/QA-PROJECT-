{
  "name": "restful-booker-api-testing",
  "version": "1.0.0",
  "description": "REST API testing portfolio for Restful Booker: Playwright APIRequestContext + Postman/Newman. Independent QA portfolio project by Elene Molashvili.",
  "author": "Elene Molashvili (https://github.com/lenossm)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report",
    "postman:test": "newman run postman/collections/restful-booker.postman_collection.json -e postman/environments/restful-booker.postman_environment.json",
    "postman:report": "newman run postman/collections/restful-booker.postman_collection.json -e postman/environments/restful-booker.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export postman/reports/newman-report.html",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.5",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
