# Copy this file to `.env` and adjust values if needed.
#
# Restful Booker is a public training API: `admin` / `password123` are its
# published, intentionally public credentials (see the API documentation at
# https://restful-booker.herokuapp.com/apidoc/index.html). They are read from
# the environment to demonstrate the correct handling of real credentials,
# which must never be hardcoded or committed.

API_BASE_URL=https://restful-booker.herokuapp.com
API_USERNAME=admin
API_PASSWORD=password123

# Response-time budget (ms) asserted by the performance-related checks.
# Generous because the free Heroku instance can be slow to respond.
RESPONSE_TIME_BUDGET_MS=5000
