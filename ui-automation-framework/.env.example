# Copy this file to `.env` and adjust values if needed.
#
# SauceDemo is a public demo application: the credentials below are published
# on its login page and are not secrets. They are still injected through
# environment variables to demonstrate the correct pattern for real projects,
# where credentials must never be hardcoded or committed.

BASE_URL=https://www.saucedemo.com

STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
SAUCE_PASSWORD=secret_sauce
